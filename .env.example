# URL pública de la web (sin barra final). Se usa para canonical, hreflang, sitemap y Open Graph.
# Mientras no haya dominio propio, usa la URL de Cloudflare Pages.
SITE_URL=https://osuna-visitas.pages.dev

# Token de Cloudflare Web Analytics (sin cookies). Vacío = analítica desactivada.
PUBLIC_CF_ANALYTICS_TOKEN=
