---
import Logo from './Logo.astro';
import Azulejo from './Azulejo.astro';
import LangSwitcher from './LangSwitcher.astro';
import Todo from './Todo.astro';
import { t, asLocale, pagePath, type PageKey } from '../i18n';
import { site } from '../data/site';

interface Props {
  pageKey?: PageKey;
}
const { pageKey } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <Azulejo id="az-footer" class="site-footer__band" />
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo tone="light" />
      <p class="site-footer__guide">
        {tr.contact.guide} · <Todo>{site.guideLicense}</Todo>
      </p>
    </div>

    <div class="site-footer__council">
      {/* TODO-V2: dato provisional. Placeholder: sustituir por el logotipo oficial facilitado por el Ayuntamiento */}
      <div class="council-placeholder" role="img" aria-label={tr.footer.councilPlaceholder}>
        <span aria-hidden="true">{tr.footer.councilPlaceholder}</span>
      </div>
      <p>{tr.footer.council}</p>
    </div>

    <nav class="site-footer__legal" aria-label={tr.footer.legalNav}>
      <ul>
        <li><a href={pagePath('legal', locale)}>{tr.footer.legal}</a></li>
        <li><a href={pagePath('privacy', locale)}>{tr.footer.privacy}</a></li>
        <li><a href={pagePath('cookies', locale)}>{tr.footer.cookies}</a></li>
        <li><a href={pagePath('credits', locale)}>{tr.footer.credits}</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <LangSwitcher pageKey={pageKey} tone="light" />
      <p>{tr.footer.photos} {tr.footer.noCookies}</p>
      <p>© {year} <Todo>{site.brand}</Todo></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --az-bg: var(--night);
    --az-star: var(--ochre);
    --az-corner: var(--night-2);
    background: var(--night);
    color: var(--night-ink);
    padding-bottom: calc(96px + env(safe-area-inset-bottom));
    font-size: 0.95rem;
  }
  .site-footer :global(.site-footer__band) {
    margin-bottom: 56px;
  }
  .site-footer a {
    color: var(--night-ink);
  }
  .site-footer a:hover {
    color: var(--ochre);
  }
  .site-footer__grid {
    display: grid;
    gap: 40px;
  }
  .site-footer p {
    margin: 0;
    color: var(--night-mute);
  }
  .site-footer__guide {
    margin-top: 16px !important;
    font-size: 0.85rem;
  }
  .site-footer__council {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 22rem;
  }
  .council-placeholder {
    display: grid;
    place-items: center;
    width: 180px;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--night-mute);
    padding: 12px;
    text-align: center;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--night-mute);
  }
  .site-footer__council p {
    color: var(--night-ink);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
  }
  .site-footer__legal ul {
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .site-footer__legal a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
  }
  .site-footer__meta {
    display: grid;
    gap: 12px;
    font-size: 0.85rem;
  }
  .site-footer__meta :global(.lang) {
    margin-left: -4px;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .site-footer {
      padding-bottom: 64px;
    }
    .site-footer__grid {
      grid-template-columns: 4fr 4fr 2fr 3fr;
      gap: var(--gutter);
    }
  }
</style>
