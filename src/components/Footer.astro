---
import Logo from './Logo.astro';
import Azulejo from './Azulejo.astro';
import LangSwitcher from './LangSwitcher.astro';
import CouncilCredit from './CouncilCredit.astro';
import { t, asLocale, pagePath, type PageKey } from '../i18n';
import { site, routes } from '../data/site';

interface Props {
  pageKey?: PageKey;
  /** En el inicio no se repite la lista de rutas, que está justo encima. */
  showRoutes?: boolean;
}
const { pageKey, showRoutes = true } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <Azulejo id="az-footer" class="site-footer__band" />
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo tone="light" />
      <p class="site-footer__guide">
        {tr.contact.guide}<br />
        <strong>{tr.facts.guideValue}</strong>
      </p>
      {site.showCouncilCredit && <CouncilCredit />}
    </div>

    {showRoutes && (<nav class="site-footer__routes" aria-label={tr.footer.routes}>
      <p class="site-footer__label">{tr.footer.routes}</p>
      <ol>
        {
          routes.map((r) => (
            <li>
              <a href={pagePath(`route-${r.id}`, locale)}>
                <span class="site-footer__num" aria-hidden="true">
                  {r.numeral}
                </span>
                {tr.routes[r.id].shortName}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>)}

    <nav class="site-footer__legal" aria-label={tr.footer.legalNav}>
      <p class="site-footer__label">{tr.footer.more}</p>
      <ul>
        <li><a href={pagePath('custom', locale)}>{tr.customPage.kicker}</a></li>
        <li><a href={pagePath('faq', locale)}>{tr.faqPage.kicker}</a></li>
        <li><a href={pagePath('legal', locale)}>{tr.footer.legal}</a></li>
        <li><a href={pagePath('privacy', locale)}>{tr.footer.privacy}</a></li>
        <li><a href={pagePath('cookies', locale)}>{tr.footer.cookies}</a></li>
        <li><a href={pagePath('credits', locale)}>{tr.footer.credits}</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <LangSwitcher pageKey={pageKey} tone="light" />
      <p>{tr.footer.photos} {tr.footer.noCookies}</p>
      <p>© {year} {site.brand}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --az-bg: var(--night);
    --az-star: var(--ochre);
    --az-corner: var(--night-2);
    background: var(--night);
    color: var(--night-ink);
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
    font-size: 0.95rem;
  }
  .site-footer :global(.site-footer__band) {
    margin-bottom: 32px;
  }
  .site-footer a {
    color: var(--night-ink);
  }
  .site-footer a:hover {
    color: var(--ochre);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px var(--gutter);
  }
  .site-footer__brand,
  .site-footer__routes,
  .site-footer__meta {
    grid-column: 1 / -1;
  }
  .site-footer p {
    margin: 0;
    color: var(--night-mute);
  }
  .site-footer__guide {
    margin-top: 14px !important;
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .site-footer__guide strong {
    color: var(--night-ink);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .site-footer__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    margin-bottom: 4px !important;
  }
  .site-footer ol,
  .site-footer ul {
    list-style: none;
  }
  .site-footer__routes ol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gutter);
  }
  .site-footer__routes a,
  .site-footer__legal a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-height: 36px;
    padding-top: 8px;
    line-height: 1.25;
    text-decoration: none;
  }
  .site-footer__routes a:hover,
  .site-footer__legal a:hover {
    text-decoration: underline;
  }
  .site-footer__num {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ochre);
    min-width: 1.9rem;
  }
  .site-footer__legal {
    grid-column: 1 / -1;
  }
  /* Móvil: enlaces en línea, que ocupan dos o tres renglones en vez de una columna larga */
  .site-footer__legal ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
  }
  .site-footer__meta {
    display: grid;
    gap: 10px;
    font-size: 0.85rem;
  }
  .site-footer__meta :global(.lang) {
    margin-left: -4px;
  }

  @media (min-width: 48rem) {
    .site-footer__brand {
      grid-column: 1;
    }
    .site-footer__meta {
      grid-column: 2;
      grid-row: 1;
    }
  }
  @media (min-width: 64rem) {
    .site-footer {
      padding-bottom: 64px;
    }
    .site-footer__grid {
      grid-template-columns: 3fr 5fr 3fr 3fr;
      gap: var(--gutter);
    }
    .site-footer__brand,
    .site-footer__routes,
    .site-footer__legal,
    .site-footer__meta {
      grid-column: auto;
      grid-row: auto;
    }
    .site-footer__legal ul {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
