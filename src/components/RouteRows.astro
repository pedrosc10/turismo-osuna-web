---
/**
 * Filas de rutas como un índice de guía impresa: numeral romano, nombre, una frase y una miniatura
 * con encuadre variable. Se usa en el inicio (las 7) y al final de cada ruta (las relacionadas).
 * La ruta nocturna rompe en azul noche. Ver DESIGN.md §11.
 */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { t, asLocale, pagePath } from '../i18n';
import { routes as allRoutes, type RouteId } from '../data/site';

interface Props {
  ids?: RouteId[];
}
const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
const routes = Astro.props.ids ? Astro.props.ids.map((id) => allRoutes.find((r) => r.id === id)!) : allRoutes;
---

<ol class="ri__list">
  {
    routes.map((r) => (
      <li class:list={['ri__item', { 'ri__item--night on-night': r.night }]}>
        <a class="ri__link" href={pagePath(`route-${r.id}`, locale)}>
          <span class="ri__num" aria-hidden="true">
            {r.numeral}
          </span>
          <span class="ri__text">
            <h3 class="ri__name">{tr.routes[r.id].shortName}</h3>
            <span class="ri__teaser">{tr.routes[r.id].teaser}</span>
          </span>
          <span class="ri__media">
            <Photo
              name={r.image}
              alt=""
              sizes="(min-width: 64rem) 132px, (min-width: 48rem) 96px, 64px"
              widths={[128, 192, 264, 400]}
              pictureClass={r.arch ? 'ri__picture arch' : 'ri__picture'}
              class="ri__img"
            />
          </span>
          <span class="ri__go" aria-hidden="true">
            <Icon name="arrow" />
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .ri__list {
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .ri__item {
    border-bottom: 1px solid var(--rule);
  }
  .ri__link {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr) 64px;
    column-gap: 12px;
    align-items: center;
    padding: 10px 0;
    text-decoration: none;
    color: inherit;
  }
  .ri__num {
    font-family: var(--serif);
    font-weight: 200;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--olive);
    font-variation-settings: 'SOFT' 100;
  }
  .ri__name {
    font-size: 1.12rem;
    font-weight: 430;
    line-height: 1.15;
    hyphens: auto;
  }
  .ri__teaser {
    display: block;
    margin-top: 2px;
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .ri__media :global(.ri__picture) {
    display: block;
    width: 64px;
    height: 64px;
    background: var(--stone-2);
  }
  .ri__media :global(.ri__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ri__go {
    display: none;
  }
  .ri__link:hover .ri__name {
    color: var(--terra);
  }
  .ri__link:hover .ri__go {
    color: var(--terra);
    transform: translateX(4px);
  }

  /* VII: la noche como ruptura, también en el índice */
  .ri__item--night {
    background: var(--night);
    color: var(--night-ink);
    border-bottom: 0;
    margin: 0 calc(-1 * var(--margin));
    padding: 0 var(--margin);
  }
  .ri__item--night .ri__num {
    color: var(--ochre);
  }
  .ri__item--night .ri__name {
    font-style: italic;
  }
  .ri__item--night .ri__teaser {
    color: var(--night-mute);
  }
  .ri__item--night .ri__link:hover .ri__name,
  .ri__item--night .ri__link:hover .ri__go {
    color: var(--ochre);
  }

  @media (min-width: 48rem) {
    .ri__link {
      grid-template-columns: 4rem minmax(0, 1fr) 96px;
      column-gap: var(--gutter);
      padding: 14px 0;
    }
    .ri__num {
      font-size: 2.4rem;
    }
    .ri__media :global(.ri__picture) {
      width: 96px;
      height: 96px;
    }
  }

  @media (min-width: 64rem) {
    .ri__link {
      grid-template-columns: 5rem minmax(0, 1fr) 132px 28px;
      padding: 16px 0;
    }
    .ri__num {
      font-size: 3rem;
    }
    .ri__name {
      font-size: 1.5rem;
    }
    .ri__teaser {
      font-size: 1rem;
    }
    /* Miniaturas con encuadres distintos: el arco (I, IV) más alto, el resto apaisado */
    .ri__media :global(.ri__picture) {
      width: 132px;
      height: 88px;
    }
    .ri__media :global(.ri__picture.arch) {
      height: 120px;
      width: 96px;
      margin-left: auto;
    }
    .ri__go {
      display: block;
      transition: transform 0.2s var(--ease);
    }
    .ri__go :global(svg) {
      width: 22px;
      height: 22px;
    }
    .ri__item--night {
      margin: 0;
      padding: 0 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ri__link:hover .ri__go {
      transform: none;
    }
  }
</style>
