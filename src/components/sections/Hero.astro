---
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import { t, asLocale } from '../../i18n';
import { site, whatsappUrl, telUrl } from '../../data/site';

const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <figure class="hero__media">
      <Photo
        name="colegiata-exterior"
        alt={tr.alt['colegiata-exterior']}
        sizes="(min-width: 64rem) 46vw, 100vw"
        widths={[480, 720, 960, 1280, 1600]}
        eager
        pictureClass="hero__picture arch"
        class="hero__img"
      />
      <figcaption class="fig">{tr.hero.caption}</figcaption>
    </figure>

    <div class="hero__text">
      <p class="kicker">{tr.hero.kicker}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">{tr.hero.titleA}</span>
        <em class="hero__line hero__line--em">{tr.hero.titleB}</em>
      </h1>
      <p class="lead hero__lead">{tr.hero.lead}</p>

      <div class="hero__actions">
        <a class="btn hero__cta" href={whatsappUrl(tr.wa.general)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          {tr.cta.whatsapp}
          <span class="visually-hidden">{tr.cta.newTab}</span>
        </a>
        <a class="textlink" href={telUrl}>
          <Icon name="phone" class="hero__phone-icon" />
          <span>{tr.cta.call} · {site.phoneDisplay}</span>
        </a>
      </div>

      <ul class="hero__badges">
        <li class="hero__langs-codes">
          <span aria-hidden="true">{tr.hero.badges[0]}</span>
          <span class="visually-hidden">{tr.hero.badgesLabel}</span>
        </li>
        <li>{tr.hero.badges[1]}</li>
        <li>{tr.hero.badges[2]}</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 16px 0 28px;
  }
  .hero__grid {
    display: grid;
    gap: 0;
  }
  .hero__media {
    margin: 0;
  }
  .hero__media .fig {
    display: none;
  }
  .hero__media :global(.hero__picture) {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--stone-2);
  }
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }
  .hero__text {
    position: relative;
    z-index: 2;
    margin-top: -56px;
    padding-top: 0;
  }
  .hero__text .kicker {
    display: inline-flex;
    background: var(--stone);
    padding: 14px 16px 6px 0;
    margin-bottom: 0;
  }
  .hero__title {
    font-size: var(--step-5);
    line-height: 0.98;
    font-weight: 360;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
    font-variation-settings: 'SOFT' 30, 'WONK' 0;
  }
  .hero__line {
    display: block;
  }
  .hero__line:first-child {
    display: inline-block;
    background: var(--stone);
    padding: 6px 18px 0 0;
  }
  .hero__line--em {
    color: var(--terra);
    font-weight: 320;
  }
  .hero__lead {
    max-width: 36rem;
    margin-bottom: 20px;
    font-size: 1.1rem;
    line-height: 1.45;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .hero__cta {
    width: 100%;
    justify-content: center;
    min-height: 56px;
    font-size: 1.06rem;
  }
  .hero__actions :global(.hero__phone-icon) {
    width: 20px;
    height: 20px;
  }
  /* Móvil: idiomas a la izquierda y los dos distintivos apilados a la derecha (sin separadores huérfanos) */
  .hero__badges {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    list-style: none;
    gap: 2px 16px;
    margin: 20px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .hero__badges .hero__langs-codes {
    grid-row: 1 / 3;
  }
  @media (min-width: 48rem) {
    .hero__badges {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 0;
    }
    .hero__badges li + li::before {
      content: '·';
      margin: 0 12px;
      color: var(--rule);
    }
  }
  .hero__langs-codes {
    font-family: var(--serif);
    font-style: italic;
    color: var(--olive);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }

  @media (min-width: 30rem) {
    .hero__cta {
      width: auto;
    }
  }

  @media (min-width: 48rem) {
    .hero__media :global(.hero__picture) {
      aspect-ratio: 16 / 13;
    }
    .hero__text {
      margin-top: -96px;
      max-width: 40rem;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding: 40px 0 48px;
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .hero__media {
      grid-column: 7 / 13;
      grid-row: 1;
    }
    .hero__media .fig {
      display: block;
    }
    .hero__media :global(.hero__picture) {
      aspect-ratio: 5 / 6.2;
      max-height: calc(100vh - var(--header-h) - 120px);
      min-height: 520px;
      width: 100%;
    }
    .hero__text {
      grid-column: 1 / 9;
      grid-row: 1;
      margin: 0;
      max-width: none;
      padding-bottom: 56px;
    }
    .hero__title {
      margin-bottom: 32px;
    }
    .hero__line--em {
      display: inline-block;
      background: var(--stone);
      padding: 0 24px 8px 0;
    }
    .hero__lead,
    .hero__actions {
      max-width: 30rem;
    }
    .hero__lead {
      font-size: var(--step-1);
    }
    .hero__badges {
      max-width: 36rem;
    }
  }
</style>
