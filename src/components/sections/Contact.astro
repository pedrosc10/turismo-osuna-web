---
import Icon from '../Icon.astro';
import Todo from '../Todo.astro';
import { t, asLocale } from '../../i18n';
import { site, whatsappUrl, telUrl } from '../../data/site';

const tr = t(asLocale(Astro.currentLocale));
const c = tr.contact;
---

<section id="contacto" class="contact" aria-labelledby="contacto-title">
  <div class="wrap grid contact__grid">
    <div class="contact__head">
      <p class="kicker"><span class="num">07</span> {c.kicker}</p>
      <h2 id="contacto-title">{c.title}</h2>
      <p class="lead">{c.text}</p>
    </div>

    <div class="contact__ways">
      <div class="contact__way">
        <p class="contact__label">{c.whatsapp}</p>
        <a class="btn contact__wa" href={whatsappUrl(tr.wa.general)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          {c.whatsappAction}
          <span class="visually-hidden">{tr.cta.newTab}</span>
        </a>
      </div>

      <div class="contact__way">
        <p class="contact__label">{c.phone}</p>
        <a class="contact__phone" href={telUrl}>
          <Todo>{site.phoneDisplay}</Todo>
        </a>
      </div>

      <dl class="cartela contact__hours">
        <div>
          <dt>{c.hours}</dt>
          <dd>
            <ul>
              {
                site.contactHours.map((h) => (
                  <li>
                    <Todo>
                      {tr.days[h.days as keyof typeof tr.days]}: {h.hours}
                    </Todo>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div>
          <dt>{c.guide}</dt>
          <dd><Todo>{site.guideLicense}</Todo></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 80px 0 96px;
    border-top: 1px solid var(--rule);
  }
  .contact__grid {
    row-gap: 40px;
  }
  .contact__head,
  .contact__ways {
    grid-column: 1 / -1;
  }
  .contact__head h2 {
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 0.95;
    margin-bottom: 24px;
  }
  .contact__ways {
    display: grid;
    gap: 28px;
  }
  .contact__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 8px;
  }
  .contact__wa {
    min-height: 56px;
    font-size: 1.06rem;
  }
  .contact__phone {
    display: inline-block;
    font-family: var(--serif);
    font-size: clamp(2rem, 1.4rem + 3vw, 3.4rem);
    font-weight: 330;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 2px solid var(--terra);
    white-space: nowrap;
  }
  .contact__phone:hover {
    color: var(--terra);
  }
  .contact__hours ul {
    list-style: none;
  }
  .contact__hours {
    grid-template-columns: 1fr;
  }
  .contact__hours dt {
    border-bottom: 0;
    padding-bottom: 0;
  }

  @media (min-width: 48rem) {
    .contact__hours {
      grid-template-columns: minmax(10rem, auto) 1fr;
    }
    .contact__hours dt {
      border-bottom: 1px solid var(--rule);
      padding-bottom: 9px;
    }
  }

  @media (min-width: 64rem) {
    .contact {
      padding: 128px 0 136px;
    }
    .contact__head {
      grid-column: 1 / 7;
    }
    .contact__ways {
      grid-column: 8 / 13;
      padding-top: 12px;
      gap: 36px;
    }
  }
</style>
