---
import Todo from '../Todo.astro';
import { t, asLocale } from '../../i18n';

const tr = t(asLocale(Astro.currentLocale));
const f = tr.faq;
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="wrap grid faq__grid">
    <div class="faq__head">
      <p class="kicker"><span class="num">05</span> {f.kicker}</p>
      <h2 id="faq-title">{f.title}</h2>
    </div>
    <div class="faq__list">
      {
        f.items.map((item, i) => (
          <details class="faq__item" name="faq">
            <summary>
              <span class="faq__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="faq__q">{item.q}</span>
              <span class="faq__toggle" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              {'todo' in item && item.todo ? (
                <Todo block>
                  <p>{item.a}</p>
                </Todo>
              ) : (
                <p>{item.a}</p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--paper);
    padding: 80px 0 88px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .faq__head,
  .faq__list {
    grid-column: 1 / -1;
  }
  .faq__head {
    margin-bottom: 32px;
  }
  .faq__head h2 {
    font-size: var(--step-3);
  }
  .faq__list {
    border-top: 2px solid var(--ink);
  }
  .faq__item {
    border-bottom: 1px solid var(--rule);
  }
  .faq__item summary {
    list-style: none;
    display: grid;
    grid-template-columns: 2.2rem 1fr 24px;
    align-items: baseline;
    gap: 8px;
    padding: 18px 0;
    cursor: pointer;
    min-height: 48px;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--terra);
  }
  .faq__q {
    font-family: var(--serif);
    font-size: 1.22rem;
    font-weight: 420;
    line-height: 1.3;
  }
  .faq__item summary:hover .faq__q {
    color: var(--terra);
  }
  .faq__toggle {
    position: relative;
    width: 16px;
    height: 16px;
    align-self: center;
  }
  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s var(--ease);
  }
  .faq__toggle::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__toggle::after {
    transform: rotate(0deg);
  }
  .faq__a {
    padding: 0 32px 22px 2.7rem;
    max-width: 44rem;
    color: var(--ink-2);
  }
  .faq__a p {
    margin: 0;
  }

  @media (min-width: 64rem) {
    .faq {
      padding: 120px 0 128px;
    }
    .faq__head {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
    .faq__list {
      grid-column: 6 / 13;
    }
    .faq__q {
      font-size: 1.32rem;
    }
  }
</style>
