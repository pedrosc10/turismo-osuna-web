---
/** FAQ corta del inicio: solo las preguntas marcadas con home: true y un enlace a la página completa. */
import FaqList from '../FaqList.astro';
import Icon from '../Icon.astro';
import { t, asLocale, pagePath } from '../../i18n';

const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
const items = tr.faq.filter((f) => f.home);
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="wrap grid faq__grid">
    <div class="faq__head">
      <p class="kicker"><span class="num">05</span> {tr.home.faqKicker}</p>
      <h2 id="faq-title">{tr.home.faqTitle}</h2>
    </div>
    <div class="faq__list">
      <FaqList items={items} name="faq-home" />
      <a class="textlink faq__more" href={pagePath('faq', locale)}>
        {tr.cta.allFaq}
        <Icon name="arrow" class="faq__arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--paper);
    padding: 32px 0 36px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .faq__head,
  .faq__list {
    grid-column: 1 / -1;
  }
  .faq__head {
    margin-bottom: 14px;
  }
  .faq__head h2 {
    font-size: var(--step-3);
  }
  .faq__more {
    margin-top: 12px;
  }
  .faq__list :global(.faq__arrow) {
    width: 18px;
    height: 18px;
  }

  @media (min-width: 64rem) {
    .faq {
      padding: 96px 0 104px;
    }
    .faq__head {
      grid-column: 1 / 5;
      position: sticky;
      top: calc(var(--header-h) + 32px);
      align-self: start;
    }
    .faq__list {
      grid-column: 6 / 13;
    }
  }
</style>
