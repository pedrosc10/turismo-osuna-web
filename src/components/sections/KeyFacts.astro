---
/** Franja de datos clave del inicio: cifras en serif grande sobre filetes, como una cartela de museo. */
import { t, asLocale } from '../../i18n';

const tr = t(asLocale(Astro.currentLocale));
const h = tr.home;
---

<section class="kf" aria-labelledby="kf-title">
  <div class="wrap">
    <h2 id="kf-title" class="kicker"><span class="num">04</span> {h.keyKicker}</h2>
    <dl class="kf__list">
      {
        h.keyFacts.map((f) => (
          <div class="kf__item">
            <dt>{f.big}</dt>
            <dd>{f.small}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .kf {
    padding: 24px 0 28px;
  }
  .kf .kicker {
    margin-bottom: 14px;
  }
  /* Móvil: tres cifras cortas en la primera fila y dos textos en la segunda */
  .kf__list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .kf__item {
    grid-column: span 2;
    padding: 8px 10px 10px;
    border-bottom: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .kf__item:nth-child(n + 4) {
    grid-column: span 3;
  }
  .kf__item:first-child,
  .kf__item:nth-child(4) {
    padding-left: 0;
    border-left: 0;
  }
  .kf__item dt {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-variation-settings: 'SOFT' 100;
    hyphens: auto;
  }
  .kf__item dd {
    margin: 2px 0 0;
    font-size: 0.88rem;
    line-height: 1.3;
    color: var(--ink-2);
  }
  @media (min-width: 48rem) {
    .kf__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .kf__item,
    .kf__item:nth-child(n + 4) {
      grid-column: auto;
      padding: 14px 16px 16px;
      border-left: 1px solid var(--rule);
    }
    .kf__item:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
  @media (min-width: 64rem) {
    .kf {
      padding: 64px 0 72px;
    }
    .kf__item dt {
      font-size: 2.4rem;
    }
    .kf__item dd {
      font-size: 0.95rem;
    }
  }
</style>
