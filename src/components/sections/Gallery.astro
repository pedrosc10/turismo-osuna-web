---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import { t, asLocale } from '../../i18n';
import { gallery } from '../../data/site';

const tr = t(asLocale(Astro.currentLocale));
const g = tr.gallery;
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });

// Versión grande para el lightbox (WebP, máx. 1800 px).
const items = await Promise.all(
  gallery.map(async (name) => {
    const src = photos[`../../assets/photos/${name}.jpg`].default;
    const full = await getImage({ src, width: Math.min(1800, src.width), format: 'webp', quality: 72 });
    return { name, alt: tr.alt[name], full: full.src };
  }),
);
// Formas del mosaico en móvil (DESIGN.md §7): b = 2×2, w = ancho, t = alto, n = normal.
const shapes: Record<string, string> = {
  'colegiata-iglesia': 'b',
  'encarnacion-azulejo': 'w',
  'colegiata-panteon': 'n',
  aldaba: 't',
  'universidad-patio': 'b',
  'san-pedro-calle': 'n',
  'colegiata-techumbre': 'w',
  'canteras-interior': 'b',
  'casa-de-los-torres': 't',
  'tumbas-romanas': 'n',
  tejados: 'n',
  'plaza-toros-panoramica': 'w',
};
---

<section id="galeria" class="gallery" aria-labelledby="galeria-title">
  <div class="wrap gallery__head">
    <p class="kicker"><span class="num">04</span> {g.kicker}</p>
    <h2 id="galeria-title">{g.title}</h2>
  </div>

  <ul class="wrap gallery__grid" data-gallery>
    {
      items.map((item, i) => (
        <li class:list={['gallery__item', `gallery__item--${shapes[item.name] ?? 'n'}`]}>
          <a
            href={item.full}
            class="gallery__link"
            data-index={i}
            data-full={item.full}
            data-alt={item.alt}
            aria-label={g.open(item.alt)}
          >
            <Photo
              name={item.name}
              alt=""
              sizes="(min-width: 64rem) 33vw, 50vw"
              widths={[360, 540, 720, 960]}
              pictureClass="gallery__picture"
              class="gallery__img"
            />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label={g.dialog} data-lightbox>
    <div class="lightbox__inner">
      <figure class="lightbox__figure">
        <img class="lightbox__img" alt="" width="1600" height="1067" data-lb-img />
        <figcaption class="lightbox__caption">
          <span data-lb-caption></span>
          <span class="lightbox__counter" data-lb-counter aria-live="polite"></span>
        </figcaption>
      </figure>
      <button class="lightbox__btn lightbox__btn--close" type="button" data-lb-close aria-label={g.close}>
        <Icon name="close" />
      </button>
      <button class="lightbox__btn lightbox__btn--prev" type="button" data-lb-prev aria-label={g.prev}>
        <Icon name="prev" />
      </button>
      <button class="lightbox__btn lightbox__btn--next" type="button" data-lb-next aria-label={g.next}>
        <Icon name="next" />
      </button>
    </div>
  </dialog>
  <template data-lb-counter-format>{g.counter(0, 0).replace('0', '{i}').replace('0', '{n}')}</template>
</section>

<style>
  .gallery {
    padding: 88px 0 96px;
  }
  .gallery__head {
    margin-bottom: 32px;
  }
  .gallery__head h2 {
    font-size: var(--step-3);
  }
  .gallery__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 150px;
    grid-auto-flow: dense;
    gap: 6px;
  }
  .gallery__item--b {
    grid-column: span 2;
    grid-row: span 2;
  }
  .gallery__item--w {
    grid-column: span 2;
  }
  .gallery__item--t {
    grid-row: span 2;
  }
  .gallery__link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--stone-2);
  }
  .gallery__link :global(.gallery__picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gallery__link :global(.gallery__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .gallery__link:hover :global(.gallery__img) {
    transform: scale(1.03);
  }
  .gallery__link:focus-visible {
    outline-offset: -3px;
    outline-width: 4px;
  }

  @media (min-width: 64rem) {
    .gallery {
      padding: 128px 0 140px;
    }
    .gallery__head {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      margin-bottom: 48px;
    }
    .gallery__head .kicker {
      grid-column: 1 / 4;
      align-self: end;
      margin-bottom: 0.8rem;
    }
    .gallery__head h2 {
      grid-column: 4 / 12;
    }
    .gallery__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: clamp(150px, 13vw, 210px);
      grid-auto-flow: row;
      gap: 8px;
    }
    /* Colocación explícita del mosaico en escritorio */
    .gallery__item:nth-child(1) { grid-area: 1 / 1 / 3 / 4; }
    .gallery__item:nth-child(2) { grid-area: 1 / 4 / 2 / 7; }
    .gallery__item:nth-child(3) { grid-area: 2 / 4 / 3 / 6; }
    .gallery__item:nth-child(4) { grid-area: 2 / 6 / 4 / 7; }
    .gallery__item:nth-child(5) { grid-area: 3 / 1 / 5 / 4; }
    .gallery__item:nth-child(6) { grid-area: 3 / 4 / 4 / 6; }
    .gallery__item:nth-child(7) { grid-area: 4 / 4 / 5 / 7; }
    .gallery__item:nth-child(8) { grid-area: 5 / 1 / 7 / 3; }
    .gallery__item:nth-child(9) { grid-area: 5 / 3 / 7 / 4; }
    .gallery__item:nth-child(10) { grid-area: 5 / 4 / 6 / 7; }
    .gallery__item:nth-child(11) { grid-area: 6 / 4 / 7 / 5; }
    .gallery__item:nth-child(12) { grid-area: 6 / 5 / 7 / 7; }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(22, 35, 58, 0.96);
    color: var(--night-ink);
  }
  .lightbox::backdrop {
    background: rgba(22, 35, 58, 0.9);
  }
  .lightbox__inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 64px 12px 24px;
  }
  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    max-height: 100%;
  }
  .lightbox__img {
    max-width: min(100%, 1600px);
    max-height: calc(100dvh - 180px);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    max-width: 60rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.98rem;
    color: var(--night-ink);
    padding-inline: 8px;
  }
  .lightbox__counter {
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--night-mute);
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: var(--night);
    color: var(--night-ink);
    border: 1px solid rgba(237, 227, 208, 0.4);
    cursor: pointer;
  }
  .lightbox__btn:hover {
    background: var(--ochre);
    color: var(--night);
  }
  .lightbox__btn:focus-visible {
    outline: 3px solid var(--ochre);
  }
  .lightbox__btn--close {
    top: 10px;
    right: 10px;
  }
  .lightbox__btn--prev {
    left: 10px;
    bottom: 10px;
  }
  .lightbox__btn--next {
    right: 10px;
    bottom: 10px;
  }
  @media (min-width: 48rem) {
    .lightbox__inner {
      padding: 64px 88px;
    }
    .lightbox__btn--prev,
    .lightbox__btn--next {
      top: 50%;
      bottom: auto;
      transform: translateY(-50%);
    }
    .lightbox__btn--prev {
      left: 20px;
    }
    .lightbox__btn--next {
      right: 20px;
    }
    .lightbox__btn--close {
      top: 20px;
      right: 20px;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery] a[data-full]'));
  const fmt = document.querySelector<HTMLTemplateElement>('[data-lb-counter-format]')?.innerHTML ?? '{i} / {n}';

  if (dialog && links.length && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.dataset.full!;
      img.alt = link.dataset.alt!;
      caption.textContent = link.dataset.alt!;
      counter.textContent = fmt.replace('{i}', String(current + 1)).replace('{n}', String(links.length));
      // Precarga la siguiente
      const next = new Image();
      next.src = links[(current + 1) % links.length].dataset.full!;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }),
    );

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // Clic en el fondo (fuera de la imagen y de los botones) cierra
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox__inner')) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      opener?.focus();
    });
  }
</script>
