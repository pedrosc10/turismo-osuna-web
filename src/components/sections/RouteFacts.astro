---
/** Cartela de ruta: duración, idiomas, salidas y precio. */
import Todo from '../Todo.astro';
import { t, asLocale } from '../../i18n';
import { site, schedules, type Route } from '../../data/site';

interface Props {
  route: Route;
  compact?: boolean;
}
const { route, compact = false } = Astro.props;
const tr = t(asLocale(Astro.currentLocale));
const rs = tr.routesSection;
const sched = schedules[route.schedule];
const languages = tr.list(site.tourLanguages.map((l) => tr.tourLangs[l]));
---

<dl class:list={['cartela', { 'cartela--compact': compact }]}>
  <div>
    <dt>{rs.labels.duration}</dt>
    <dd>{rs.durationValue(site.durationHours)}</dd>
  </div>
  <div>
    <dt>{rs.labels.languages}</dt>
    <dd>{languages}</dd>
  </div>
  <div>
    <dt>{rs.labels.schedule}</dt>
    <dd><Todo>{tr.scheduleValue(tr.days[sched.days], sched.times)}</Todo></dd>
  </div>
  <div>
    <dt>{rs.labels.price}</dt>
    <dd>
      <Todo>{route.priceFrom !== null ? rs.priceFrom(route.priceFrom) : rs.priceOnRequest}</Todo>
    </dd>
  </div>
</dl>
