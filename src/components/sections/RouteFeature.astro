---
/** Ruta en composición destacada (foto vertical, opcionalmente en arco, y ficha al lado). */
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import RouteFacts from './RouteFacts.astro';
import { t, asLocale } from '../../i18n';
import { whatsappUrl, type Route } from '../../data/site';

interface Props {
  r: Route;
  mirror?: boolean;
}
const { r, mirror = false } = Astro.props;
const tr = t(asLocale(Astro.currentLocale));
const text = (route: Route) => tr.routes[route.id as keyof typeof tr.routes];
const book = (route: Route) => whatsappUrl(tr.wa.route(text(route).name));
---

<article
  class:list={['r-feature', { 'r-feature--mirror': mirror }]}
  id={`ruta-${r.id}`}
  aria-labelledby={`t-${r.id}`}
>
  <div class="wrap grid">
    <figure class="r-feature__media reveal">
      <Photo
        name={r.image}
        alt={tr.alt[r.image]}
        sizes="(min-width: 64rem) 40vw, (min-width: 48rem) 70vw, 100vw"
        widths={[480, 720, 960, 1280]}
        pictureClass={r.arch ? 'r-feature__picture arch' : 'r-feature__picture'}
        class="r-feature__img"
      />
      <figcaption class="fig">{text(r).caption}</figcaption>
    </figure>
    <div class="r-feature__body">
      <span class="numeral" aria-hidden="true">
        {r.numeral}
      </span>
      <h3 id={`t-${r.id}`} class="r-title">
        {text(r).name}
      </h3>
      <p class="r-desc">{text(r).desc}</p>
      <RouteFacts route={r} />
      <a class="btn r-book" href={book(r)} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        {tr.cta.bookRoute}
        <span class="visually-hidden">
          : {text(r).shortName} {tr.cta.newTab}
        </span>
      </a>
    </div>
  </div>
</article>
<style>
  /* --- Destacada --- */
  .r-feature {
    padding: 24px 0 72px;
  }
  .r-feature__media,
  .r-feature__body {
    grid-column: 1 / -1;
  }
  .r-feature__media :global(.r-feature__picture) {
    display: block;
    aspect-ratio: 3 / 3.6;
    background: var(--stone-2);
  }
  .r-feature__media :global(.r-feature__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .r-feature__body {
    margin-top: 28px;
  }


  @media (min-width: 48rem) {
    .r-feature__media {
      grid-column: 1 / 6;
    }
    .r-feature__body {
      grid-column: 1 / 9;
    }
  }

  @media (min-width: 64rem) {
    .r-feature {
      padding: 32px 0 120px;
    }
    .r-feature .grid {
      align-items: end;
    }
    .r-feature__media {
      grid-column: 2 / 7;
      grid-row: 1;
    }
    .r-feature__body {
      grid-column: 8 / 12;
      grid-row: 1;
      margin: 0;
      padding-bottom: 40px;
    }
    .r-feature--mirror .r-feature__media {
      grid-column: 7 / 12;
    }
    .r-feature--mirror .r-feature__body {
      grid-column: 1 / 6;
    }
    .r-feature .numeral {
      font-size: calc(var(--step-4) * 1.25);
    }

  }
</style>
