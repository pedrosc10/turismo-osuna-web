---
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import Todo from '../Todo.astro';
import { t, asLocale } from '../../i18n';
import { site, directionsUrl } from '../../data/site';

const tr = t(asLocale(Astro.currentLocale));
const m = tr.map;
const mp = site.meetingPoint;
---

<section id="encuentro" class="meet" aria-labelledby="encuentro-title">
  <div class="meet__grid">
    <div class="meet__map-wrap">
      <div
        class="meet__map"
        role="region"
        aria-label={m.mapLabel}
        data-map
        data-lat={mp.lat}
        data-lng={mp.lng}
        data-label={`${m.marker}: ${mp.name}`}
      >
        <noscript><p class="meet__noscript">{m.noscript}</p></noscript>
      </div>
    </div>

    <div class="meet__text">
      <p class="kicker"><span class="num">06</span> {m.kicker}</p>
      <h2 id="encuentro-title">{m.title}</h2>
      <Todo block><p>{m.text}</p></Todo>
      <address class="meet__address">
        <Todo>
          <strong>{mp.name}</strong><br />
          {`${mp.streetAddress} · ${mp.postalCode} ${mp.locality} (${mp.region})`}
        </Todo>
      </address>
      <a class="textlink" href={directionsUrl} target="_blank" rel="noopener">
        {m.directions}
        <Icon name="external" class="meet__ext" />
        <span class="visually-hidden">{tr.cta.newTab}</span>
      </a>
      <figure class="meet__photo">
        <Photo
          name="plaza-mayor"
          alt={tr.alt['plaza-mayor']}
          sizes="(min-width: 64rem) 30vw, 100vw"
          widths={[480, 720, 960]}
          pictureClass="meet__picture"
          class="meet__img"
        />
        <figcaption class="fig">{m.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .meet {
    padding: 0;
  }
  .meet__grid {
    display: grid;
  }
  .meet__map-wrap {
    position: relative;
    background: var(--stone-2);
    min-height: 340px;
  }
  .meet__map {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .meet__noscript {
    padding: 24px var(--margin);
  }
  .meet__text {
    padding: 56px var(--margin) 72px;
  }
  .meet__text h2 {
    font-size: var(--step-3);
    margin-bottom: 20px;
  }
  .meet__address {
    font-style: normal;
    margin: 4px 0 8px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .meet__address strong {
    font-family: var(--serif);
    font-weight: 450;
    font-size: 1.2rem;
  }
  .meet__text :global(.meet__ext) {
    width: 18px;
    height: 18px;
  }
  .meet__photo {
    margin-top: 36px;
    max-width: 26rem;
  }
  .meet__photo :global(.meet__picture) {
    display: block;
    aspect-ratio: 4 / 3;
  }
  .meet__photo :global(.meet__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Marcador propio en forma de arco (sin imágenes de Leaflet) */
  :global(.meet-pin) {
    width: 34px !important;
    height: 42px !important;
    margin-left: -17px !important;
    margin-top: -42px !important;
    background: var(--terra);
    border-radius: 999px 999px 0 0;
    box-shadow: 0 0 0 3px var(--paper);
  }
  :global(.meet-pin::after) {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 2px;
    height: 9px;
    background: var(--ink);
    transform: translateX(-50%);
  }
  :global(.meet .leaflet-container) {
    font-family: var(--sans);
    background: var(--stone-2);
  }
  :global(.meet .leaflet-control-attribution) {
    font-size: 0.72rem;
    background: rgba(250, 246, 238, 0.92);
    color: var(--ink);
  }
  :global(.meet .leaflet-control-attribution a) {
    color: var(--ink);
  }
  :global(.meet .leaflet-bar a) {
    width: 40px;
    height: 40px;
    line-height: 40px;
    border-radius: 0;
    color: var(--ink);
  }
  :global(.meet .leaflet-bar) {
    border-radius: 0;
    border: 1.5px solid var(--ink);
  }

  @media (min-width: 48rem) {
    .meet__map-wrap {
      min-height: 440px;
    }
  }

  @media (min-width: 64rem) {
    .meet__grid {
      grid-template-columns: 7fr 5fr;
      min-height: 720px;
    }
    .meet__text {
      padding: 104px var(--margin) 104px 56px;
      max-width: 36rem;
    }
  }
</style>

<script>
  import leafletCss from 'leaflet/dist/leaflet.css?url';
  const el = document.querySelector<HTMLElement>('[data-map]');
  if (el) {
    const init = async () => {
      // La hoja de estilos de Leaflet se carga solo cuando hace falta (no bloquea el primer render)
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = leafletCss;
      document.head.append(link);
      const { default: L } = await import('leaflet');
      const lat = Number(el.dataset.lat);
      const lng = Number(el.dataset.lng);
      const map = L.map(el, { scrollWheelZoom: false, zoomControl: true }).setView([lat, lng], 17);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      const icon = L.divIcon({ className: 'meet-pin', iconSize: [34, 42] });
      L.marker([lat, lng], { icon, title: el.dataset.label, alt: el.dataset.label, keyboard: false }).addTo(map);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            init();
          }
        },
        { rootMargin: '400px' },
      );
      io.observe(el);
    } else {
      init();
    }
  }
</script>
