---
import Base from '../../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import Routes from '../sections/Routes.astro';
import Custom from '../sections/Custom.astro';
import Gallery from '../sections/Gallery.astro';
import Faq from '../sections/Faq.astro';
import MeetingPoint from '../sections/MeetingPoint.astro';
import Contact from '../sections/Contact.astro';
import { t, asLocale, pagePath } from '../../i18n';
import { site, routes, minPrice } from '../../data/site';

const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
const siteUrl = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const pageUrl = `${siteUrl}${pagePath('home', locale)}`;
const businessId = `${siteUrl}/#business`;
const mp = site.meetingPoint;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: site.brand,
      inLanguage: ['es', 'en', 'de'],
      publisher: { '@id': businessId },
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: tr.meta.title,
      description: tr.meta.description,
      inLanguage: tr.locale,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': businessId },
    },
    {
      '@type': 'TravelAgency',
      '@id': businessId,
      name: site.brand,
      description: tr.meta.description,
      url: pageUrl,
      image: `${siteUrl}/og/og-${locale}.jpg`,
      logo: `${siteUrl}/logo.svg`,
      telephone: site.phone,
      priceRange: `${minPrice}–${Math.max(...routes.map((r) => r.priceFrom ?? 0))} €`,
      currenciesAccepted: 'EUR',
      knowsLanguage: site.tourLanguages,
      address: {
        '@type': 'PostalAddress',
        streetAddress: mp.streetAddress,
        postalCode: mp.postalCode,
        addressLocality: mp.locality,
        addressRegion: mp.region,
        addressCountry: mp.country,
      },
      geo: { '@type': 'GeoCoordinates', latitude: mp.lat, longitude: mp.lng },
      areaServed: {
        '@type': 'City',
        name: 'Osuna',
        containedInPlace: { '@type': 'AdministrativeArea', name: 'Provincia de Sevilla, Andalucía, España' },
      },
      openingHours: site.openingHoursSchema,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: site.phone,
        contactType: 'reservations',
        availableLanguage: ['Spanish', 'English', 'German', 'Italian'],
      },
    },
    ...routes.map((r) => {
      const rt = tr.routes[r.id as keyof typeof tr.routes];
      return {
        '@type': 'TouristTrip',
        '@id': `${pageUrl}#ruta-${r.id}`,
        name: rt.name,
        description: rt.desc,
        url: `${pageUrl}#ruta-${r.id}`,
        inLanguage: tr.locale,
        touristType: ['Cultural tourism', 'Heritage tourism'],
        provider: { '@id': businessId },
        ...(r.priceFrom !== null && {
          offers: {
            '@type': 'Offer',
            price: r.priceFrom,
            priceCurrency: 'EUR',
            url: `${pageUrl}#ruta-${r.id}`,
            availability: 'https://schema.org/InStock',
            offeredBy: { '@id': businessId },
          },
        }),
      };
    }),
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage: tr.locale,
      mainEntity: tr.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<Base title={tr.meta.title} description={tr.meta.description} pageKey="home" jsonLd={jsonLd} isHome>
  <Hero />
  <Routes />
  <Custom />
  <Gallery />
  <Faq />
  <MeetingPoint />
  <Contact />
</Base>
