---
import Base from '../../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import RouteIndex from '../sections/RouteIndex.astro';
import CustomTeaser from '../sections/CustomTeaser.astro';
import KeyFacts from '../sections/KeyFacts.astro';
import Faq from '../sections/Faq.astro';
import Visit from '../sections/Visit.astro';
import { t, asLocale, pagePath } from '../../i18n';
import { site, routes } from '../../data/site';
import { businessNode, businessId, faqNode, webPageNode } from '../../lib/seo';

const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
const siteUrl = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const pageUrl = `${siteUrl}${pagePath('home', locale)}`;

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: `${siteUrl}/`,
    name: site.brand,
    inLanguage: ['es', 'en', 'de'],
    publisher: { '@id': businessId(siteUrl) },
  },
  { ...webPageNode(siteUrl, pageUrl, tr.meta.title, tr.meta.description, tr.locale), about: { '@id': businessId(siteUrl) } },
  businessNode(siteUrl, locale, tr),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#rutas`,
    name: tr.home.routesTitle,
    itemListElement: routes.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tr.routes[r.id].name,
      url: `${siteUrl}${pagePath(`route-${r.id}`, locale)}`,
    })),
  },
  faqNode(
    `${pageUrl}#faq`,
    tr.faq.filter((f) => f.home),
    tr.locale,
  ),
];
---

<Base title={tr.meta.title} description={tr.meta.description} pageKey="home" jsonLd={jsonLd} isHome>
  <Hero />
  <RouteIndex />
  <CustomTeaser />
  <KeyFacts />
  <Faq />
  <Visit />
</Base>
