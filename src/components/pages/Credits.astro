---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { t, asLocale, pagePath } from '../../i18n';
import { credits } from '../../data/credits';
import { breadcrumbNode, webPageNode, type Crumb } from '../../lib/seo';

const locale = asLocale(Astro.currentLocale);
const tr = t(locale);
const c = tr.credits;
const siteUrl = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const crumbs: Crumb[] = [
  { name: tr.nav.home, key: 'home' },
  { name: c.title, key: 'credits' },
];
const jsonLd = [
  webPageNode(siteUrl, `${siteUrl}${pagePath('credits', locale)}`, c.metaTitle, c.metaDesc, tr.locale),
  breadcrumbNode(siteUrl, locale, crumbs),
];
---

<Base title={c.metaTitle} description={c.metaDesc} pageKey="credits" jsonLd={jsonLd}>
  <article class="wrap grid credits-page">
    <header class="credits-page__head">
      <Breadcrumbs crumbs={crumbs} />
      <p class="kicker">{tr.footer.credits}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.intro}</p>
      <p class="credits-page__note">{c.logo}</p>
    </header>
    <ol class="credits-page__list">
      {
        credits.map((cr, i) => (
          <li>
            <span class="credits-page__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <p class="credits-page__title">{tr.alt[cr.file.replace('.jpg', '')] ?? cr.title}</p>
              <dl class="cartela">
                <div>
                  <dt>{c.author}</dt>
                  <dd>{cr.author}</dd>
                </div>
                <div>
                  <dt>{c.license}</dt>
                  <dd>
                    {cr.licenseUrl ? (
                      <a href={cr.licenseUrl} rel="license noopener" target="_blank">
                        {cr.license}
                      </a>
                    ) : (
                      c.publicDomain
                    )}
                  </dd>
                </div>
                <div>
                  <dt>{c.source}</dt>
                  <dd>
                    <a href={cr.source} target="_blank" rel="noopener">
                      {cr.title}
                      <span class="visually-hidden"> {tr.cta.newTab}</span>
                    </a>
                  </dd>
                </div>
                <div>
                  <dt>{c.photo}</dt>
                  <dd>{c.changes[cr.changes]}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))
      }
    </ol>
  </article>
</Base>

<style>
  .credits-page {
    padding-top: 16px;
    padding-bottom: 104px;
  }
  .credits-page__head,
  .credits-page__list {
    grid-column: 1 / -1;
  }
  .credits-page__head h1 {
    font-size: var(--step-4);
    font-weight: 300;
    margin-bottom: 20px;
    hyphens: auto;
  }
  .credits-page__note {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .credits-page__list {
    list-style: none;
    margin-top: 40px;
    display: grid;
    gap: 36px;
  }
  .credits-page__list li {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 8px;
  }
  .credits-page__n {
    font-family: var(--serif);
    font-style: italic;
    color: var(--terra);
    font-size: 1.1rem;
  }
  .credits-page__title {
    font-family: var(--serif);
    font-size: 1.1rem;
    margin-bottom: 10px;
  }
  .credits-page :global(.cartela dd) {
    overflow-wrap: anywhere;
  }
  @media (min-width: 64rem) {
    .credits-page {
      padding-top: 32px;
    }
    .credits-page__head {
      grid-column: 1 / 8;
    }
    .credits-page__list {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
      row-gap: 48px;
    }
  }
</style>
